# SSH: retain only non-secret portable client configuration.
/.ssh/*
!/.ssh/config

# Regenerable user cache.
(?d)/.cache/**

# Host-local configuration/state.
# Do NOT use (?d): these may contain valuable state, credentials, or local data.
/.config/**
/.local/**

# Nx: normally regenerable workspace/tool state.
# Use ordinary ignore instead if ~/.nx contains configuration you want retained.
/.nx
/.nx/**

# Python: all safe to recreate from requirements/lock files.
(?d)**/.venv
(?d)**/.venv/**
(?d)**/venv
(?d)**/venv/**
(?d)**/.tox
(?d)**/.tox/**
(?d)**/.mypy_cache
(?d)**/.mypy_cache/**
(?d)**/.pytest_cache
(?d)**/.pytest_cache/**
(?d)**/.ruff_cache
(?d)**/.ruff_cache/**
(?d)**/__pycache__
(?d)**/__pycache__/**

# Never synchronize project .env files.
# Do NOT use (?d) unless every .env is definitely disposable.
/.env
**/.env

# Go module/cache trees.
# IMPORTANT: remove **/pkg/** — it hides real source directories.
/.gopkg/**
/go/pkg/mod/**
/go/pkg/sumdb/**

# If ~/.gopkg and ~/go/pkg/mod are purely caches on every host, use:
# (?d)/.gopkg/**
# (?d)/go/pkg/mod/**
# (?d)/go/pkg/sumdb/**

# Node/Bun/JS generated dependencies and caches.
(?d)**/node_modules
(?d)**/node_modules/**
(?d)**/.npm
(?d)**/.npm/**
(?d)**/.yarn
(?d)**/.yarn/**
(?d)**/.pnpm-store
(?d)**/.pnpm-store/**
(?d)**/.bun
(?d)**/.bun/**
(?d)**/bun-install-cache
(?d)**/bun-install-cache/**
(?d)**/bun-install-cache*/
(?d)**/bun-install-cache*/**

# VS Code remote/server installations and extensions.
# These are reinstallable; deletion may cause a re-download/rebuild.
(?d)/.vscode/extensions
(?d)/.vscode/extensions/**
(?d)/.vscode-server
(?d)/.vscode-server/**

# Transient NFS handles and Syncthing marker.
(?d)/.nfs*
/.stfolder

# Editor temporary/recovery files.
(?d)**/*.swp
(?d)**/*.swo
(?d)**/*~
(?d)/.viminfo

# Shell history is local state, not disposable build output.
/.zsh_history
/.zcompdump*

# Snap-managed application data: retain unless you explicitly want
# local Snap application data deleted with a remotely deleted parent.
/snap/**

# Optional R library. It is reinstallable but may be expensive to restore.
# Keep ordinary ignore unless automatic deletion is explicitly desired.
/.local/lib/R/site-library/**
{
  "$schema": "https://opencode.ai/config.json",

  "model": "edgexpert-vllm/qwen3.6-35b-a3b",
  "default_agent": "plan",

  "provider": {
    "edgexpert-vllm": {
      "name": "EdgeXpert GB10 vLLM",
      "npm": "@ai-sdk/openai-compatible",

      "options": {
        "baseURL": "http://edgexpert-d43d.np.dotnot.pl:7869/v1"
      },

      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (EdgeXpert GB10)",

          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },

    "terra-llama": {
      "name": "Terra RTX 3090 llama.cpp",
      "npm": "@ai-sdk/openai-compatible",

      "options": {
        "baseURL": "http://terra.wsl.dotnot.pl:7869/v1"
      },

      "models": {
        "qwen3.6-coder": {
          "name": "Qwen3.6-35B-A3B UD Q4_K_M (Terra RTX 3090)",

          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  }
}

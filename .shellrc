# shell common options (bash, zsh, etc.)

# Host secrets are shared by Bash and Zsh.
[ -r ~/.shellrc-secrets ] && source ~/.shellrc-secrets

# ANSI colors; \001 and \002 mark nonprinting sequences for Bash Readline.
rblk="\001\e[0;30m\002" # Black
rred="\001\e[0;31m\002" # Regular Red
rgrn="\001\e[0;32m\002" # Regular Green
rylw="\001\e[0;33m\002" # Regular Yellow
rblu="\001\e[0;34m\002" # Regular Blue
rpur="\001\e[0;35m\002" # Regular Purple
rcyn="\001\e[0;36m\002" # Regular Cyan
rwht="\001\e[0;37m\002" # Regular White
gray="\001\e[1;30m\002" # Gray
lred="\001\e[1;31m\002" # Light Red
lgrn="\001\e[1;32m\002" # Light Green
lylw="\001\e[1;33m\002" # Light Yellow
lblu="\001\e[1;34m\002" # Light Blue
lpur="\001\e[1;35m\002" # Light Purple
lcyn="\001\e[1;36m\002" # Light Cyan
lwht="\001\e[1;37m\002" # Light White
rst="\001\e[m\002"     # Text Reset

# Default Bash prompt colors and hostname label; local config may override them.
host_color=${rgrn}
user_color=${lblu}
host_alias='\h'

# set default umask
umask 027

case `uname` in
  'Linux')
    LS_OPTIONS="--color"
  ;;
  'SunOS')
  ;;
  *)
  echo 'What am I?'
  ;;
esac

export LS_OPTIONS

# set proper timezone
export TZ='Europe/Warsaw'

# Pick engine: prefer podman, fallback to docker
_container_engine() {
  if command -v podman >/dev/null 2>&1; then
    printf '%s\n' podman
  elif command -v docker >/dev/null 2>&1; then
    printf '%s\n' docker
  else
    printf 'No podman or docker found in PATH\n' >&2
    return 1
  fi
}

# Generic "run current dir in container"
in_container() {
  local image="$1"
  shift

  local engine
  engine="$(_container_engine)" || return 1

  "$engine" run \
    -v "$PWD":/workspace:Z \
    -w /workspace \
    --rm -it \
    "$image" "$@"
}

in_rocky9()   { in_container rockylinux:9 "$@"; }
in_alpine()   { in_container alpine:latest "$@"; }
in_busybox()  { in_container busybox:latest "$@"; }
in_ubuntu()   { in_container ubuntu:24.04 "$@"; }

# Aliases for commonly used cmds
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

alias ls="ls $LS_OPTIONS"
alias ll="ls $LS_OPTIONS -l"
alias l="ls $LS_OPTIONS -lA"
alias la='ls -A'
function pr() {
  if [ -z "${proxy}" ]; then
    echo "WARN: \$proxy is not set" >&2
    return 1
  fi
  http_proxy="$proxy" https_proxy="$proxy" "$@"
}
alias rmb='find -name "*~" -print -delete'
#alias pip="https_proxy=$proxy; pip --proxy=$http_proxy"

alias pys="echo 'http://'`hostname -f`':8000'; python3 -m http.server 8000"

# force simple authentication
alias ldapsearch="ldapsearch -x"

# alias for getting ssh keys from GitHub
alias ssh-key-github='curl https://github.com/KarolKozlowski.keys'

# pwgen shortcut
#alias pwg='pwgen -sny1 20'
function pw() {
  LC_ALL=C tr -dc '[:alnum:]' </dev/urandom | head -c ${1:-32}; echo
}
function pwg() {
  LC_ALL=C tr -dc '[:graph:]' </dev/urandom | head -c ${1:-20}; echo
}

# preserve working dir across ssh sessions
alias ssh='env SSH_PWD="$PWD" /bin/ssh'
if [ -n "$SSH_PWD" ]; then
   cd "$SSH_PWD"
   unset SSH_PWD
fi

# setup ssh agent bridge
[ -e ~/wa/shellpers/agent-bridge.sh ] && source ~/wa/shellpers/agent-bridge.sh

# setup ussers hosts file for tab-completion
[ -e ~/.ssh/hosts ] && export HOSTFILE=~/.ssh/hosts

# ~/bin
PATH=$HOME/bin:$PATH
# shelpers
PATH=$HOME/wa/shellpers:$PATH
# local bin
PATH=$HOME/.local/bin:$PATH
# npm
PATH=$HOME/.npm-global/bin:$PATH
# go path
PATH=$HOME/go/bin:$PATH
# Add current dir to PATH
# PATH=.:$PATH
# include python site-packages in PATH
#[ -n "${PYTHONPATH}" ] && PATH=${PYTHONPATH}:$PATH
# opencode
export PATH=$HOME/.opencode/bin:$PATH

# CDPATH
CDPATH=.
CDPATH=$CDPATH:$HOME
CDPATH=$CDPATH:$HOME/wa
CDPATH=$CDPATH:$HOME/wa/ansible
[ -d /var/lib/jenkins ] && CDPATH=$CDPATH:/var/lib/jenkins
[ -d /mnt/c/Users/karol ] && CDPATH=${CDPATH}:/mnt/c/Users/karol

export CDPATH

# less config
export LESS="--quit-if-one-screen --quit-at-eof --RAW-CONTROL-CHARS --no-init"
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# tell gpg where to ask for pass
if [[ -o interactive && -n $TTY ]]; then
  export GPG_TTY="$TTY"
fi

# the one and only
export EDITOR="$(command -v nvim || command -v vim)"
alias vim=nvim

# check for dtop binary and unalias dtop if present
if { [ -n "${ZSH_VERSION-}" ] && whence -p dtop >/dev/null; } ||
   { [ -z "${ZSH_VERSION-}" ] && type -P dtop >/dev/null; }; then
  unalias dtop 2>/dev/null
fi

unalias md 2>/dev/null
function md() {
    mkdir -p "${1}"
    cd "${1}"
}

# Host-specific overrides are applied after shared defaults.
[ -r ~/.shellrc-local ] && source ~/.shellrc-local

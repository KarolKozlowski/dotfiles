# shell common options (bash, zsh, etc.)

# --- Secrets and prompt defaults ---
# Secrets shared by Bash and Zsh.
[ -r ~/.shellrc-secrets ] && source ~/.shellrc-secrets

# Prompt colors. The markers identify nonprinting ANSI sequences to Bash Readline.
rblk="\001\e[0;30m\002" # Black
rred="\001\e[0;31m\002" # Regular Red
rgrn="\001\e[0;32m\002" # Regular Green
rylw="\001\e[0;33m\002" # Regular Yellow
rblu="\001\e[0;34m\002" # Regular Blue
rpur="\001\e[0;35m\002" # Regular Purple
rcyn="\001\e[0;36m\002" # Regular Cyan
rwht="\001\e[0;37m\002" # Regular White
gray="\001\e[1;30m\002" # Gray
lred="\001\e[1;31m\002" # Light Red
lgrn="\001\e[1;32m\002" # Light Green
lylw="\001\e[1;33m\002" # Light Yellow
lblu="\001\e[1;34m\002" # Light Blue
lpur="\001\e[1;35m\002" # Light Purple
lcyn="\001\e[1;36m\002" # Light Cyan
lwht="\001\e[1;37m\002" # Light White
rst="\001\e[m\002"      # Text Reset

# Shared prompt defaults; host-specific settings can override these at the end.
host_color=${rgrn}
user_color=${lblu}
host_alias='\h'

# --- Shell and platform defaults ---
umask 027
export TZ='Europe/Warsaw'

# --- Search paths and directory shortcuts ---
# Add each path only once, keeping the existing precedence order.
path_prepend_once() {
  case ":${PATH-}:" in
    *":$1:"*) ;;
    *) PATH="$1${PATH:+:$PATH}" ;;
  esac
}

path_prepend_once "$HOME/bin"
path_prepend_once "$HOME/wa/shellpers"
path_prepend_once "$HOME/.local/bin"
path_prepend_once "$HOME/.npm-global/bin"
path_prepend_once "$HOME/go/bin"
path_prepend_once "$HOME/.opencode/bin"
export PATH

# CDPATH lets cd search these locations when given a relative directory name.
CDPATH=.
CDPATH=$CDPATH:$HOME
CDPATH=$CDPATH:$HOME/wa
CDPATH=$CDPATH:$HOME/wa/ansible
[ -d /mnt/c/Users/karol ] && CDPATH=${CDPATH}:/mnt/c/Users/karol
export CDPATH

# --- Container helpers ---
# Pick engine: prefer podman, fallback to docker
_container_engine() {
  if command -v podman >/dev/null 2>&1; then
    printf '%s\n' podman
  elif command -v docker >/dev/null 2>&1; then
    printf '%s\n' docker
  else
    printf 'No podman or docker found in PATH\n' >&2
    return 1
  fi
}

# Generic "run current dir in container"
in_container() {
  local image="$1"
  shift

  local engine
  engine="$(_container_engine)" || return 1

  "$engine" run \
    -v "$PWD":/workspace:Z \
    -w /workspace \
    --rm -it \
    "$image" "$@"
}

in_rocky9()   { in_container rockylinux:9 "$@"; }
in_alpine()   { in_container alpine:latest "$@"; }
in_busybox()  { in_container busybox:latest "$@"; }
in_ubuntu()   { in_container ubuntu:24.04 "$@"; }

# --- Command aliases and helpers ---
unset GREP_OPTIONS
if [ -x /usr/bin/dircolors ]; then
  LS_OPTIONS="--color"
  GREP_OPTIONS="--color=auto"
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

export LS_OPTIONS

alias grep="grep $GREP_OPTIONS"
alias fgrep="fgrep $GREP_OPTIONS"
alias egrep="egrep $GREP_OPTIONS"
alias ls="ls $LS_OPTIONS"
alias ll="ls $LS_OPTIONS -l"
alias l="ls $LS_OPTIONS -lA"
alias la='ls -A'

# Confirm before removing files or overwriting destinations.
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Run commands through the configured proxy.
function pr() {
  if [ -z "${proxy}" ]; then
    echo "WARN: \$proxy is not set" >&2
    return 1
  fi
  http_proxy="$proxy" https_proxy="$proxy" "$@"
}

# File cleanup and local web server shortcuts.
alias rmb='find -name "*~" -print -delete'
#alias pip="https_proxy=$proxy; pip --proxy=$http_proxy"

pys() {
  printf 'http://%s:8000\n' "$(hostname -f)"
  python3 -m http.server 8000
}

# Authentication and source-control shortcuts.
alias ldapsearch="ldapsearch -x"
alias ssh-key-github='curl https://github.com/KarolKozlowski.keys'

# Generate random passwords.
#alias pwg='pwgen -sny1 20'
function pw() {
  LC_ALL=C tr -dc '[:alnum:]' </dev/urandom | head -c ${1:-32}; echo
}
function pwg() {
  LC_ALL=C tr -dc '[:graph:]' </dev/urandom | head -c ${1:-20}; echo
}

# --- SSH integration ---
# Preserve the working directory across SSH sessions.
alias ssh='env SSH_PWD="$PWD" /bin/ssh'
if [ -n "$SSH_PWD" ]; then
   cd "$SSH_PWD"
   unset SSH_PWD
fi

# Connect to the host SSH agent when the bridge is available.
[ -e ~/wa/shellpers/agent-bridge.sh ] && source ~/wa/shellpers/agent-bridge.sh

# Optional host list used by SSH completion.
[ -e ~/.ssh/hosts ] && export HOSTFILE=~/.ssh/hosts

# --- Terminal settings ---
export LESS="--quit-if-one-screen --quit-at-eof --RAW-CONTROL-CHARS --no-init"
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# Tell GPG which terminal to use for prompts.
if [[ -o interactive && -n $TTY ]]; then
  export GPG_TTY="$TTY"
fi

# Preferred editor.
if EDITOR=$(command -v nvim); then
  alias vim=nvim
else
  EDITOR=$(command -v vim)
fi
export EDITOR

# Avoid alias conflicts with installed helper commands.
if { [ -n "${ZSH_VERSION-}" ] && whence -p dtop >/dev/null; } ||
   { [ -z "${ZSH_VERSION-}" ] && type -P dtop >/dev/null; }; then
  unalias dtop 2>/dev/null
fi

# --- Directory helper ---
# Create a directory and enter it.
unalias md 2>/dev/null
function md() {
    mkdir -p "${1}"
    cd "${1}"
}

# --- Host-specific overrides ---
# Loaded last so host settings can replace shared defaults.
[ -r ~/.shellrc-local ] && source ~/.shellrc-local

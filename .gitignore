# ignore vim views
.vim/view/

# ignore vim history
.vim/.netrwhist

# Ignore all tmux plugins
.tmux/plugins/*

# But keep TPM itself (submodule or plain dir)
!.tmux/plugins/tpm/

# lazy.nvim plugin lockfile, host-specific
.config/nvim/lazy-lock.*

# Ignore OpenCode dynamic runtime & lock files
.config/opencode/service.json
.config/opencode/package-lock.json

